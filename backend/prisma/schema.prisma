// نظام ميزان المحاسبي — مخطط قاعدة البيانات
// كل المبالغ تُخزَّن كأعداد صحيحة بالوحدة الصغرى (قروش/فلس) لتفادي أخطاء الفاصلة العائمة.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


// المستخدمون وصلاحياتهم في قاعدة النظام المركزية لا هنا — انظر system.prisma.
// قاعدة المنشأة بيانات محاسبية خالصة، فيمكن نسخها ونقلها ونسخها احتياطياً وحدها.

// ───────────────────────── شجرة الحسابات ─────────────────────────


model Account {
  id       String      @id @default(cuid())
  code     String      @unique
  name     String
  type     String // ASSET | LIABILITY | EQUITY | INCOME | EXPENSE
  parentId String?
  parent   Account?    @relation("AccountTree", fields: [parentId], references: [id])
  children Account[]   @relation("AccountTree")

  // حساب تجميعي لا يقبل القيود مباشرة
  isGroup  Boolean @default(false)
  // حساب نظامي يستخدمه البرنامج (الذمم المدينة/الدائنة…) فلا يُحذف
  systemKey String? @unique
  active   Boolean @default(true)

  lines        JournalLine[]
  invoiceLines InvoiceLine[] @relation("InvoiceLineAccount")
  payments     Payment[]     @relation("PaymentCashAccount")
  itemsSales     Item[] @relation("ItemSalesAccount")
  itemsExpense   Item[] @relation("ItemExpenseAccount")
  itemsInventory Item[] @relation("ItemInventoryAccount")
  itemsCogs      Item[] @relation("ItemCogsAccount")
  adjustments    StockAdjustment[] @relation("AdjustmentCounterAccount")
  assetsCost        FixedAsset[] @relation("AssetCostAccount")
  assetsAccumulated FixedAsset[] @relation("AssetAccumulatedAccount")
  assetsExpense     FixedAsset[] @relation("AssetExpenseAccount")

  @@index([type])
  @@index([parentId])
}

// ───────────────────────── العملاء والموردون ─────────────────────────


model Party {
  id        String    @id @default(cuid())
  code      String    @unique
  kind      String // CUSTOMER | SUPPLIER | BOTH
  name      String
  phone     String?
  email     String?
  address   String?
  taxNumber String?
  notes     String?
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())

  invoices Invoice[]
  payments Payment[]
  lines    JournalLine[]

  @@index([kind])
  @@index([name])
}

// ───────────────────────── القيود اليومية ─────────────────────────


model JournalEntry {
  id       String      @id @default(cuid())
  number   Int         @unique
  date     DateTime
  memo     String?
  source   String @default("MANUAL") // MANUAL | INVOICE | PAYMENT | ADJUSTMENT | OPENING | CLOSING
  // معرّف المستند الذي ولّد القيد (فاتورة أو سند) — لحذفه معه
  sourceId String?

  // المستخدم في قاعدة النظام لا هنا، فلا علاقة أجنبية. والاسم لقطة تُحفظ لحظة
  // الترحيل فيبقى أثر المسؤولية مقروءاً حتى لو حُذف المستخدم لاحقاً.
  createdById   String?
  createdByName String?
  createdAt   DateTime @default(now())

  lines JournalLine[]
  fiscalClose FiscalClose?
  depreciations Depreciation[]

  @@index([date])
  @@index([source, sourceId])
}

// إقفال سنة مالية: قيد يصفّر الإيرادات والمصروفات ويرحّل نتيجتها إلى الأرباح
// المحتجزة. صفٌّ واحد لكل سنة مقفلة، وحذف قيده يعيد فتحها.
model FiscalClose {
  id String @id @default(cuid())

  // أول يوم في السنة المالية وآخر يوم فيها — وتاريخ القيد هو آخر يوم
  startDate DateTime
  endDate   DateTime @unique

  // صافي النتيجة المرحَّلة: موجب ربح وسالب خسارة، بالوحدة الصغرى
  netResult BigInt

  entryId String       @unique
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([endDate])
}

model JournalLine {
  id      String       @id @default(cuid())
  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  accountId String
  account   Account @relation(fields: [accountId], references: [id])

  partyId String?
  party   Party?  @relation(fields: [partyId], references: [id])

  // بالوحدة الصغرى؛ أحدهما صفر دائماً
  debit  BigInt @default(0)
  credit BigInt @default(0)

  memo String?

  @@index([accountId])
  @@index([partyId])
  @@index([entryId])
}

// ───────────────────────── الفواتير ─────────────────────────



model Invoice {
  id     String      @id @default(cuid())
  kind   String // SALES | PURCHASE
  number String
  date   DateTime
  dueDate DateTime?

  partyId String
  party   Party  @relation(fields: [partyId], references: [id])

  status String @default("DRAFT") // DRAFT | POSTED | CANCELLED
  notes  String?

  // مجاميع محسوبة ومخزَّنة بالوحدة الصغرى
  subtotal BigInt @default(0)
  taxTotal BigInt @default(0)
  total    BigInt @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines      InvoiceLine[]
  allocations PaymentAllocation[]

  @@unique([kind, number])
  @@index([partyId])
  @@index([date])
  @@index([status])
}

model InvoiceLine {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  // الصنف اختياري: السطر الحر بوصف وحساب يدوي ما زال مدعوماً
  itemId String?
  item   Item?   @relation(fields: [itemId], references: [id])

  description String
  // الكمية بثلاث منازل عشرية مخزَّنة كعدد صحيح (1.5 => 1500)
  quantity    BigInt @default(1000)
  // سعر الوحدة بالوحدة الصغرى
  unitPrice   BigInt @default(0)
  // نسبة الضريبة بالعُشر من المئة (15% => 1500)
  taxRate     Int    @default(0)

  // حساب الإيراد (للمبيعات) أو المصروف (للمشتريات)
  accountId String
  account   Account @relation("InvoiceLineAccount", fields: [accountId], references: [id])

  lineSubtotal BigInt @default(0)
  lineTax      BigInt @default(0)
  lineTotal    BigInt @default(0)

  sortOrder Int @default(0)

  // المستودع الذي يخرج منه الصنف أو يدخل إليه — للأصناف المخزنية وحدها
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([invoiceId])
  @@index([itemId])
}

// ───────────────────────── سندات القبض والصرف ─────────────────────────



model Payment {
  id     String      @id @default(cuid())
  kind   String // RECEIPT | PAYMENT
  number String
  date   DateTime

  partyId String
  party   Party  @relation(fields: [partyId], references: [id])

  // الحساب النقدي/البنكي
  cashAccountId String
  cashAccount   Account @relation("PaymentCashAccount", fields: [cashAccountId], references: [id])

  amount BigInt @default(0)
  status String @default("DRAFT") // DRAFT | POSTED | CANCELLED
  reference String?
  notes     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  allocations PaymentAllocation[]

  @@unique([kind, number])
  @@index([partyId])
  @@index([date])
}

// توزيع السند على الفواتير
model PaymentAllocation {
  id        String  @id @default(cuid())
  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    BigInt  @default(0)

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
}

// ───────────────────────── إعدادات المنشأة ─────────────────────────

model Settings {
  id              Int      @id @default(1)
  companyName     String   @default("منشأتي")
  currencyCode    String   @default("SAR")
  currencySymbol  String   @default("ر.س")
  decimalPlaces   Int      @default(2)
  fiscalYearStart Int      @default(1) // رقم الشهر 1..12
  defaultTaxRate  Int      @default(0) // بالعُشر من المئة
  // لا يُسمح بقيود قبل هذا التاريخ (إقفال فترة)
  lockDate        DateTime?

  // بيانات تُطبع على الفواتير والتقارير
  taxNumber String?
  address   String?
  phone     String?
  email     String?

  // ترقيم المستندات: البادئة لكل نوع، وهل يدخل العام في الرقم، وعدد الخانات.
  // تغيير البادئة يبدأ تسلسلاً جديداً من 1 ولا يمسّ أرقام المستندات القائمة.
  prefixSales      String  @default("INV")
  prefixPurchase   String  @default("PUR")
  prefixReceipt    String  @default("RCT")
  prefixPayment    String  @default("PMT")
  prefixAdjustment String  @default("ADJ")
  prefixTransfer   String  @default("TRF")
  numberIncludeYear Boolean @default(true)
  numberPadding     Int     @default(4)

  // وحدة المخزون: تُعطَّل للمنشآت الخدمية فتختفي شاشاتها وتُرفض حركاتها
  inventoryEnabled Boolean @default(true)

  updatedAt DateTime @updatedAt
}

// ───────────────────────── الأصناف والمخزون ─────────────────────────

model Item {
  id   String @id @default(cuid())
  code String @unique
  name String
  // STOCK: صنف مخزني يُتابَع كمياً وتُحسب تكلفته — SERVICE: خدمة بلا مخزون
  kind String @default("STOCK")
  unit String @default("حبة")

  // أسعار استرشادية تُقترح عند إدخال الفاتورة
  salePrice     BigInt @default(0)
  purchasePrice BigInt @default(0)
  // نسبة الضريبة الافتراضية بالعُشر من المئة
  taxRate Int @default(0)

  salesAccountId String
  salesAccount   Account @relation("ItemSalesAccount", fields: [salesAccountId], references: [id])

  // حساب المصروف لفواتير شراء الخدمات
  expenseAccountId String?
  expenseAccount   Account? @relation("ItemExpenseAccount", fields: [expenseAccountId], references: [id])

  // حسابا المخزون وتكلفة المبيعات — يرجعان للحسابين النظاميين عند تركهما فارغين
  inventoryAccountId String?
  inventoryAccount   Account? @relation("ItemInventoryAccount", fields: [inventoryAccountId], references: [id])
  cogsAccountId      String?
  cogsAccount        Account? @relation("ItemCogsAccount", fields: [cogsAccountId], references: [id])

  // الرصيد الجاري: مشتق من حركة المخزون ويُحدَّث معها في المعاملة نفسها
  onHand     BigInt @default(0) // الكمية ×1000
  stockValue BigInt @default(0) // قيمة المخزون بالوحدة الصغرى

  reorderLevel BigInt  @default(0)
  notes        String?
  active       Boolean @default(true)
  createdAt    DateTime @default(now())

  moves        StockMove[]
  invoiceLines InvoiceLine[]
  adjustmentLines StockAdjustmentLine[]
  stocks       ItemStock[]
  transferLines StockTransferLine[]

  @@index([kind])
  @@index([name])
}

// حركة مخزون واحدة بالتكلفة المتوسطة المرجّحة؛ الرصيد بعدها محفوظ في السطر نفسه
model StockMove {
  id     String @id @default(cuid())
  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  date DateTime
  // IN: وارد — OUT: منصرف
  kind String

  quantity  BigInt // موجبة دائماً؛ الاتجاه من kind
  unitCost  BigInt // تكلفة الوحدة المطبَّقة على هذه الحركة
  totalCost BigInt

  // رصيد الصنف بعد هذه الحركة
  balanceQty   BigInt
  balanceValue BigInt

  // INVOICE | ADJUSTMENT | TRANSFER
  sourceType String
  sourceId   String?
  memo       String?
  createdAt  DateTime @default(now())

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([itemId, date])
  @@index([itemId, warehouseId, date])
  @@index([sourceType, sourceId])
}

// تسوية مخزون: أرصدة افتتاحية، فروق جرد، تالف
model StockAdjustment {
  id     String   @id @default(cuid())
  number String   @unique
  date   DateTime
  reason String?
  status String   @default("DRAFT") // DRAFT | POSTED | CANCELLED
  notes  String?

  // الطرف المقابل: رأس المال للأرصدة الافتتاحية، أو حساب فروق الجرد
  counterAccountId String
  counterAccount   Account @relation("AdjustmentCounterAccount", fields: [counterAccountId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines StockAdjustmentLine[]

  @@index([date])
  @@index([status])
}

model StockAdjustmentLine {
  id           String          @id @default(cuid())
  adjustmentId String
  adjustment   StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  // IN: إدخال للمخزون — OUT: إخراج منه
  direction String
  quantity  BigInt
  // تُستخدم للإدخال فقط؛ الإخراج يأخذ المتوسط المرجّح الجاري
  unitCost  BigInt @default(0)
  memo      String?
  sortOrder Int    @default(0)

  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  @@index([adjustmentId])
  @@index([itemId])
}

// ───────────────────────── الأصول الثابتة ─────────────────────────

// أصل ثابت يُهلَك على عمره الإنتاجي. حساباته مذكورة في البطاقة نفسها لا
// بمفاتيح نظامية، فتعمل على شجرة حسابات أي منشأة قائمة دون إضافة حسابات.
model FixedAsset {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?

  acquiredAt DateTime
  // التكلفة والقيمة التخريدية بالوحدة الصغرى
  cost         BigInt
  salvageValue BigInt @default(0)

  // STRAIGHT_LINE: قسط ثابت — DECLINING_BALANCE: قسط متناقص على الرصيد الدفتري
  method           String @default("STRAIGHT_LINE")
  usefulLifeMonths Int    @default(60)
  // نسبة القسط المتناقص السنوية بالعُشر من المئة (20% => 2000)
  decliningRate    Int    @default(0)

  assetAccountId       String
  assetAccount         Account @relation("AssetCostAccount", fields: [assetAccountId], references: [id])
  accumulatedAccountId String
  accumulatedAccount   Account @relation("AssetAccumulatedAccount", fields: [accumulatedAccountId], references: [id])
  expenseAccountId     String
  expenseAccount       Account @relation("AssetExpenseAccount", fields: [expenseAccountId], references: [id])

  // ACTIVE | DISPOSED
  status           String    @default("ACTIVE")
  disposedAt       DateTime?
  disposalProceeds BigInt    @default(0)

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  depreciations Depreciation[]

  @@index([status])
  @@index([acquiredAt])
}

// دفعة إهلاك لأصل في فترة. القيد يحمل كل أصول الدفعة، والصف هنا يربط الأصل بها.
model Depreciation {
  id      String     @id @default(cuid())
  assetId String
  asset   FixedAsset @relation(fields: [assetId], references: [id], onDelete: Cascade)

  // آخر يوم في الفترة المُهلَكة
  periodEnd DateTime
  months    Int    @default(1)
  amount    BigInt
  // الرصيد الدفتري بعد هذه الدفعة — يُقرأ منه الرصيد دون إعادة حساب التاريخ كله
  bookValueAfter BigInt

  entryId String
  entry   JournalEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([assetId, periodEnd])
  @@index([periodEnd])
  @@index([entryId])
}

// ───────────────────────── المستودعات ─────────────────────────

// مستودع يُتابَع رصيد كل صنف وتكلفته فيه على حدة. المتوسط المرجّح يُطبَّق لكل
// مستودع وحده، فالبضاعة المشتراة بتكلفتين في مكانين لا يختلط متوسطها.
model Warehouse {
  id   String @id @default(cuid())
  code String @unique
  name String

  // مستودع واحد افتراضي يُستعمل حين لا يحدِّد المستند مستودعاً
  isDefault Boolean @default(false)
  active    Boolean @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks          ItemStock[]
  moves           StockMove[]
  invoiceLines    InvoiceLine[]
  adjustmentLines StockAdjustmentLine[]
  transfersOut    StockTransfer[] @relation("TransferFrom")
  transfersIn     StockTransfer[] @relation("TransferTo")

  @@index([active])
}

// رصيد صنف في مستودع. مجموع هذه الصفوف هو رصيد الصنف الكلي في بطاقته.
model ItemStock {
  id String @id @default(cuid())

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  onHand     BigInt @default(0)
  stockValue BigInt @default(0)

  @@unique([itemId, warehouseId])
  @@index([warehouseId])
}

// تحويل بضاعة بين مستودعين. لا يمسّ الدفتر: البضاعة تخرج من مكان وتدخل آخر
// بالتكلفة نفسها، وحساب المخزون واحد — فالقيد يكون من المخزون إلى المخزون.
model StockTransfer {
  id     String   @id @default(cuid())
  number String   @unique
  date   DateTime

  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])

  // DRAFT | POSTED | CANCELLED
  status String  @default("DRAFT")
  notes  String?

  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines StockTransferLine[]

  @@index([date])
  @@index([status])
}

model StockTransferLine {
  id         String        @id @default(cuid())
  transferId String
  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id])

  quantity  BigInt
  memo      String?
  sortOrder Int     @default(0)

  @@index([transferId])
  @@index([itemId])
}

// ───────────────────────── ترحيل البيانات ─────────────────────────

// ما نُفِّذ من ترحيلات البيانات على هذه القاعدة. مواءمة الجداول (db push) لا
// تملأ بيانات، وبعض التغييرات تحتاج ملء صفوف قائمة — تُسجَّل هنا لتُنفَّذ مرة.
model DataMigration {
  name      String   @id
  appliedAt DateTime @default(now())
  note      String?
}
